{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	// Wiring baseline (code glow-up re-pass, 2026-07-03). Gate the
	// low-false-positive classes — dead FILES and unused/missing DEPENDENCIES —
	// so NEW dead code fails CI. Export/type checks are deferred: barrel
	// re-exports (the src/lib/**/index.ts files) produce a large false-positive
	// set (139 in the first pass) that needs a consent-gated triage, not a gate.
	// See the deletion manifest before removing anything ignored here.
	"include": ["files", "dependencies", "unlisted", "unresolved"],
	// Residential syncs run from launchd through scripts/sync-runner.sh, which
	// knip can't read (2026-09-29). Declared as entries so their imports are traced.
	"entry": ["scripts/sync-*.mjs"],
	"ignore": [
		// Confirmed FALSE POSITIVES — kept permanently (Codex-verified, see the
		// 2026-07-03 deletion manifest). knip can't see their real callers:
		"scripts/lib/activity-feed-helpers.d.mts", // .d.mts type companion for the used .mjs
		"scripts/lib/strava-explore-helpers.d.mts", // .d.mts type companion for the used .mjs
		"scripts/scrape-proxy.mjs", // invoked by a LaunchAgent (com.marinmonitor.scrape-proxy)
		".superpowers/**" // agent tool scratch, gitignored via its own nested .gitignore
	],
	"ignoreDependencies": [
		// Documented false positives: @typescript-eslint/* are peer-deps of the
		// typescript-eslint meta-package; @types/d3 is ambient types for d3
		// (which IS used, so it's never imported directly).
		"@typescript-eslint/eslint-plugin",
		"@typescript-eslint/parser",
		"@types/d3"
	]
}
